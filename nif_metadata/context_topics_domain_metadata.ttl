    nif:isString "CRICKET - AUSTRALIA 228-9 IN 50 OVERS V SRI LANKA .  COLOMBO 1996-08-30  Australia scored 228 for nine wickets in their 50 overs against Sri Lanka in the third day-night limited overs match of the Singer World Series tournament on Friday . " .

<https://anonymiz.ed/AIDA-YAGO2-dataset/05872255aa2781e56c874391ae2e2dc57a0c366f9ee392e862f1d8228e8eb34b> a nif:Context,
        nif:OffsetBasedString ;
